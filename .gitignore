# Data files
data/
!data/.gitkeep

# Model files (too large for GitHub)
models/
!models/.gitkeep

# Reports and figures
reports/

# Jupyter notebooks (not needed in deployment)
notebooks/

# Examples (not needed in deployment)
examples/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
.env

# Development config files (keep only essential ones in git)
config/models/*.yaml
!config/models/model_registry.yaml
config/prediction/*.yaml
!config/prediction/predict_gaia_teff_corrected_log.yaml
!config/prediction/predict_gaia_cluster_teff_corrected_log.yaml
!config/prediction/predict_gaia_logg_teff_log_corrected.yaml
!config/prediction/template_prediction.yaml
config/validation/*.yaml
!config/validation/validate_gaia_cluster_teff_corrected_log.yaml
!config/validation/template_validation.yaml

# Development scripts (keep only deployment scripts)
scripts/*
!scripts/download_datasets.py
!scripts/upload_to_huggingface.py
!scripts/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
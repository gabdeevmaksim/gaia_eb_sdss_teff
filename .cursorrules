## 2. Reusable Modules for Notebooks

### Create src/notebook_utils.py
NEVER duplicate data loading, plotting, or utility code in notebooks. Create reusable functions.

```python
# src/notebook_utils.py
from typing import Union, Optional
import pandas as pd
import polars as pl
from pathlib import Path
from src.config import get_config

def load_ml_data(with_gaia: bool = True, format: str = 'pandas') -> Union[pd.DataFrame, pl.DataFrame]:
    """
    Load ML training data.

    Parameters
    ----------
    with_gaia : bool
        Whether to load data with Gaia colors
    format : str
        'pandas' or 'polars'
    """
    config = get_config()
    if with_gaia:
        file_path = config.get_dataset_path('ml_training_with_gaia', 'processed')
    else:
        file_path = config.get_dataset_path('ml_training_clean', 'processed')

    if format == 'pandas':
        return pd.read_parquet(file_path)
    elif format == 'polars':
        return pl.read_parquet(file_path)
    else:
        raise ValueError(f"Unknown format: {format}")

def load_model(model_id: str):
    """Load trained model by ID."""
    import joblib
    config = get_config()
    models_dir = config.get_path('models')
    model_file = models_dir / f"{model_id}.pkl"
    return joblib.load(model_file)

def save_figure(fig, filename: str, subdir: Optional[str] = None, dpi: int = 300, **kwargs):
    """
    Save matplotlib figure to reports/figures.

    Parameters
    ----------
    fig : matplotlib.figure.Figure
        Figure to save
    filename : str
        Output filename (e.g., 'temperature_distribution.png')
    subdir : str, optional
        Subdirectory within figures/ (e.g., 'exploratory')
    dpi : int
        Resolution (default: 300)
    """
    config = get_config()
    figures_dir = config.get_path('figures', ensure_exists=True)

    if subdir:
        save_dir = figures_dir / subdir
        save_dir.mkdir(parents=True, exist_ok=True)
    else:
        save_dir = figures_dir

    save_path = save_dir / filename
    fig.savefig(save_path, dpi=dpi, bbox_inches='tight', **kwargs)
    print(f"Saved: {save_path}")

# Export constants for notebooks
CONFIG = get_config()
MISSING_VALUE = CONFIG.get('processing', 'missing_value')
TEST_SIZE = CONFIG.get('ml', 'test_size')
RANDOM_STATE = CONFIG.get('ml', 'random_state')
```


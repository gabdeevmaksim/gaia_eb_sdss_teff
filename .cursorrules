## 3. Feature Engineering Module

### Create src/features/engineering.py
All feature engineering should be modular and reusable across notebooks and pipelines.

```python
# src/features/engineering.py
from typing import List, Tuple
import pandas as pd
import numpy as np
from sklearn.feature_selection import SelectKBest, f_regression

def engineer_all_features(
    df: pd.DataFrame,
    color_cols: List[str],
    mag_cols: List[str] = None,
    include_polynomials: bool = True,
    include_interactions: bool = True,
    include_log: bool = True,
    include_temp_dependent: bool = True,
    include_mag_features: bool = True
) -> pd.DataFrame:
    """
    Engineer all features for ML model.

    Parameters
    ----------
    df : pd.DataFrame
        Input dataframe
    color_cols : list of str
        Color column names (e.g., ['g_r_color', 'r_i_color'])
    mag_cols : list of str, optional
        Magnitude column names
    """
    df_eng = df.copy()

    if include_polynomials:
        df_eng = create_polynomial_features(df_eng, color_cols, degree=3)

    if include_interactions:
        df_eng = create_interaction_features(df_eng, color_cols)

    if include_log:
        df_eng = create_log_features(df_eng, color_cols)

    if include_temp_dependent:
        df_eng = create_temperature_dependent_features(df_eng, color_cols)

    if include_mag_features and mag_cols:
        df_eng = create_magnitude_features(df_eng, mag_cols)

    return df_eng

def create_polynomial_features(df: pd.DataFrame, cols: List[str], degree: int = 2) -> pd.DataFrame:
    """Create polynomial features (x^2, x^3, etc.)."""
    df_out = df.copy()
    for col in cols:
        for d in range(2, degree + 1):
            df_out[f'{col}_pow{d}'] = df[col] ** d
    return df_out

def create_interaction_features(df: pd.DataFrame, cols: List[str]) -> pd.DataFrame:
    """Create pairwise interaction features (x1 * x2)."""
    df_out = df.copy()
    for i, col1 in enumerate(cols):
        for col2 in cols[i+1:]:
            df_out[f'{col1}_x_{col2}'] = df[col1] * df[col2]
    return df_out

def select_best_features(
    X: pd.DataFrame,
    y: pd.Series,
    k: int = 20,
    score_func=f_regression
) -> Tuple[pd.DataFrame, object]:
    """
    Select k best features using univariate feature selection.

    Returns
    -------
    X_selected : pd.DataFrame
        Selected features
    selector : SelectKBest
        Fitted selector (for transforming new data)
    """
    selector = SelectKBest(score_func=score_func, k=k)
    X_selected = selector.fit_transform(X, y)
    selected_features = X.columns[selector.get_support()].tolist()

    return pd.DataFrame(X_selected, columns=selected_features, index=X.index), selector

def get_feature_importance(model, feature_names: List[str], top_n: int = 20) -> pd.DataFrame:
    """
    Get feature importance from tree-based model.

    Returns
    -------
    pd.DataFrame
        Feature importance sorted by importance
    """
    importance_df = pd.DataFrame({
        'feature': feature_names,
        'importance': model.feature_importances_
    }).sort_values('importance', ascending=False)

    return importance_df.head(top_n)
```


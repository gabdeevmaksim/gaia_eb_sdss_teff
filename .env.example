# Environment variables for Docker containers
# Copy this file to .env and fill in your credentials

# HuggingFace Hub (required for dataset/model downloads)
HF_TOKEN=your_huggingface_token_here

# Kaggle (optional, if using Kaggle datasets)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Model to auto-download (optional)
# Example: rf_gaia_teff_corrected_log_20251126_130144
MODEL_NAME=

# Data cache directories (optional, defaults shown)
# DATA_CACHE_DIR=/app/data/processed
# MODEL_CACHE_DIR=/app/models
